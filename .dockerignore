# 构建上下文为项目根目录（见 docker/docker-compose.yaml 的 build.context: ..）
# 这里只放行镜像真正需要的文件，避免把 .git / 测试 / 文档传进构建上下文。
.git
.github
.workbuddy
tests
docs
reports
tools
scripts
fnpk
hooks
*.md
LICENSE
.gitignore
.dockerignore

# ===== 闭源目录（标准版 / 专业版）—— 绝不进入镜像构建上下文 =====
# 与 .gitignore 对齐：src/enforcers/ 与 src/editions/ 含闭源代码，
# 即便被 .gitignore 挡在 git 之外，Docker 默认仍会把它们纳入构建上下文，
# 必须在此显式排除，否则会被 Dockerfile 的 COPY src/ 烤进公开镜像。
src/enforcers/
src/editions/

# ===== 闭源知识库数据（open-core：社区版镜像不含真实内容）=====
# 与 src/knowledge_base/.gitignore 对齐：完整域名库 / 行为库 / OUI 库 / 签名
# 均为闭源核心资产，不进公开仓；但 Docker 构建上下文默认会纳入被 gitignore 挡住
# 的磁盘残留文件，必须在此显式排除，否则会被 Dockerfile 的 COPY src/ 烤进公开镜像、
# 经 GHCR 外泄。社区版镜像只分发加载器（constants.py / updater.py / VERSION），
# 真实数据由用户自建源或内网镜像按需提供。
src/knowledge_base/domains.csv
src/knowledge_base/behaviors.json
src/knowledge_base/oui_prefixes.csv
src/knowledge_base/domains_homeward.csv
src/knowledge_base/domains_public.csv
src/knowledge_base/seeds/cloud_cdn.csv
src/knowledge_base/seeds/privacy_trackers.csv
src/knowledge_base/SIGNATURE
src/knowledge_base/CHECKSUM
