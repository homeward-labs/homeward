#!/bin/sh
# homeward pre-commit guard
# 目的：防止标准版/专业版（闭源）代码被误提交到公开仓库。
# 触发：每次 git commit 前自动运行（见 git config core.hooksPath）。
# 兼容 Windows git bash：不使用 mktemp/touch/rm，改用管道子shell退出码传递。

CLOSED_DIRS="src/enforcers src/editions/standard src/editions/pro"
SENTINELS="@closed-source @standard-only @pro-only"

# 管道子shell 内做检查；命中违规则 exit 1，否则 exit 0。
# 主脚本通过 $? 读取子shell退出码来决定是否放行。
git diff --cached -z --name-only --diff-filter=ACM | {
  while IFS= read -r -d '' f || [ -n "$f" ]; do
    [ -z "$f" ] && continue

    # 1) 目录级拦截（对所有文件生效）
    for d in $CLOSED_DIRS; do
      case "$f" in
        "$d"/*)
          echo "BLOCKED: '$f' 位于闭源目录 '$d'，禁止提交到公开仓库。"
          echo "   请将其保留在本地/私有仓库，或用 git restore --staged '$f' 取消暂存。"
          exit 1
          ;;
      esac
    done

    # 2) 内容标记拦截（仅对 src/ 下源码生效，文档与脚本可合法提及这些词）
    case "$f" in
      src/*)
        for s in $SENTINELS; do
          if grep -q -- "$s" "$f" 2>/dev/null; then
            echo "BLOCKED: '$f' 含有闭源标记 '$s'，禁止提交到公开仓库。"
            echo "   如确需开源请先移除该标记；否则取消暂存并放入 src/enforcers 或 src/editions/*。"
            exit 1
          fi
        done
        ;;
    esac
  done
  exit 0
}

rc=$?
if [ "$rc" -ne 0 ]; then
  exit 1
fi

echo "OK: 未发现闭源代码泄露，提交放行。"
